# Copy to .env and fill in. Never commit real secrets.
# Defaults below run the WHOLE app locally with no Docker — SQLite, local file
# storage, and inline job execution. You only really need an OpenRouter key.

ENV=development

# --- LLM / media provider: OpenRouter (text + image + video) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
# Verify the video slug at https://openrouter.ai/collections/video-models
OPENROUTER_VIDEO_MODEL=google/veo-3.1

# --- Local-dev runtime (no Docker) ---
# database_url defaults to sqlite; storage_backend=local; job_runner=inline.
# Override only if you want the production stack below.
# DATABASE_URL=sqlite+aiosqlite:///./lumina.db
# JOB_RUNNER=inline
# STORAGE_BACKEND=local
# API_BASE_URL=http://localhost:8000

# --- Optional: extra media providers (added later) ---
FAL_API_KEY=
REPLICATE_API_TOKEN=

# --- Optional: production stack (Postgres + Redis + S3/MinIO) ---
# DATABASE_URL=postgresql+asyncpg://lumina:lumina@localhost:5432/lumina
# REDIS_URL=redis://localhost:6379/0
# JOB_RUNNER=arq
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=lumina-media
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=http://localhost:9000/lumina-media
