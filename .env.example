# Copy to .env and fill in. Never commit real secrets.

# --- Postgres ---
POSTGRES_USER=lumina
POSTGRES_PASSWORD=lumina
POSTGRES_DB=lumina
DATABASE_URL=postgresql+asyncpg://lumina:lumina@localhost:5432/lumina

# --- Redis (queue + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally; S3/R2 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lumina-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/lumina-media

# --- Media providers (video/image) ---
# Leave blank to run the adapter in stub/mock mode (no real generation / spend).
FAL_API_KEY=
REPLICATE_API_TOKEN=

# --- LLM provider (text: prompt enhancement, captioning) ---
# OpenRouter is a unified gateway over many LLMs. Blank => stub mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Image-capable model on OpenRouter (real text-to-image). Costs apply.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview

# --- App ---
API_BASE_URL=http://localhost:8000
ENV=development
