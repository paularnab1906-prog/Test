# Copy to .env and fill in. Never commit real secrets.

# --- Postgres ---
POSTGRES_USER=lumina
POSTGRES_PASSWORD=lumina
POSTGRES_DB=lumina
DATABASE_URL=postgresql+asyncpg://lumina:lumina@localhost:5432/lumina

# --- Redis (queue + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally; S3/R2 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lumina-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/lumina-media

# --- Providers ---
# Leave blank to run the fal adapter in stub/mock mode (no real generation).
FAL_API_KEY=

# --- App ---
API_BASE_URL=http://localhost:8000
ENV=development
